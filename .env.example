# --- Server (never exposed to the browser) ---
# PostgreSQL connection string (Neon, Supabase, Timescale/Tiger Cloud, RDS...). Include sslmode=require for hosted DBs.
DATABASE_URL=postgres://user:password@host:5432/jobappy?sslmode=require
# Random 32+ char secret used to sign sessions: `openssl rand -base64 32`
AUTH_SECRET=change-me
# Optional shared AI keys. Signed-in users can use AI without adding their own key.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Optional self-hosted Piston (https://github.com/engineer-man/piston) for the code runner, e.g. https://piston.example.com/api/v2.
# Without it, non-JavaScript code runs on the free public Wandbox service; JavaScript always runs in the browser.
# CODE_RUNNER_URL=

# --- Billing (Razorpay subscriptions, ₹199/month) ---
# Key pair from Razorpay Dashboard → Settings → API Keys. Use test keys until you go live.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Monthly plan id: create it once with `npm run razorpay:plan` (prints the id).
# RAZORPAY_PLAN_ID=
# Webhook secret you choose when adding https://<domain>/api/billing/webhook in the dashboard (subscription.* events).
# RAZORPAY_WEBHOOK_SECRET=
# Free trial length in days for new accounts (default 7).
# TRIAL_DAYS=7
# Encrypts learners' AI provider keys at rest; falls back to AUTH_SECRET when unset. `openssl rand -base64 32`
# AI_KEY_ENCRYPTION_SECRET=

# --- Public (inlined into the browser bundle) ---
# Google OAuth *Web* client ID with the Gmail API enabled and your origin(s) in "Authorized JavaScript origins".
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
