# --- Server (never exposed to the browser) ---
# PostgreSQL connection string (Neon, Supabase, Timescale/Tiger Cloud, RDS...). Include sslmode=require for hosted DBs.
DATABASE_URL=postgres://user:password@host:5432/jobappy?sslmode=require
# Production migrations prefer POSTGRES_URL_NON_POOLING, then DATABASE_URL_NON_POOLING,
# then DATABASE_URL. Configure the selected variable in the Vercel deployment environment.
# For migration TLS with a private CA, set the provider's PEM certificate in Vercel.
# Literal \\n separators and multiline PEM values are supported; certificate verification stays enabled.
# DATABASE_SSL_CA=
# Random 32+ char secret used to sign sessions: `openssl rand -base64 32`
AUTH_SECRET=change-me
# Optional shared AI keys. Signed-in users can use AI without adding their own key.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Optional self-hosted Piston (https://github.com/engineer-man/piston) for the code runner, e.g. https://piston.example.com/api/v2.
# Without it, non-JavaScript code runs on the free public Wandbox service; JavaScript always runs in the browser.
# CODE_RUNNER_URL=

# --- Billing (Razorpay one-time passes: 90 days ₹199, 180 days ₹424, 1 year ₹799) ---
# Key pair from Razorpay Dashboard → Settings → API Keys. Use test keys until you go live.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook secret you choose when adding https://<domain>/api/billing/webhook (events: payment.captured, order.paid).
# RAZORPAY_WEBHOOK_SECRET=
# Emails that always have access without paying (operators, testers), comma separated.
# BILLING_ALLOWLIST=
# Encrypts learners' AI provider keys at rest; falls back to AUTH_SECRET when unset. `openssl rand -base64 32`
# AI_KEY_ENCRYPTION_SECRET=

# --- Sign-in ---
# Google sign-in: OAuth web client with https://<domain>/api/auth/callback/google as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email confirmation for password sign-ups. Either a Resend API key…
# RESEND_API_KEY=
# …or any SMTP server (smtp://user:pass@host:587 or smtps://user:pass@host:465).
# SMTP_URL=
# Sender shown on verification emails, e.g. "Prep by EVOLW <hello@evolw.in>". Required with either mailer.
# EMAIL_FROM=
# Public origin used in emails and metadata.
# NEXT_PUBLIC_SITE_URL=https://prep.evolw.in
