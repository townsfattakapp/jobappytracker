VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_PROJECT_NAME=jobappy
VITE_APPWRITE_DATABASE_ID=jobappy
VITE_APPWRITE_COLLECTION_ID=app_state
# Google OAuth Web client ID (public). Enable Gmail API + authorized JS origins.
# VITE_GOOGLE_CLIENT_ID=
# Optional local-only Groq key (prefer saving key in the Email import UI)
# VITE_GROQ_API_KEY=
# Server-only for scripts/setup-appwrite.mjs — do not commit real keys
# APPWRITE_API_KEY=
