# --- Server (never exposed to the browser) ---
# PostgreSQL connection string (Neon, Supabase, Timescale/Tiger Cloud, RDS...). Include sslmode=require for hosted DBs.
DATABASE_URL=postgres://user:password@host:5432/jobappy?sslmode=require
# Production migrations prefer POSTGRES_URL_NON_POOLING, then DATABASE_URL_NON_POOLING,
# then DATABASE_URL. Configure the selected variable in the Vercel deployment environment.
# Deploys never migrate automatically. Run `npm run db:preflight:production` (read-only), take a backup, then
# `MIGRATE_PRODUCTION_APPROVED=HOST:PORT/DB npm run db:migrate:production -- --approve=HOST:PORT/DB`.
# MIGRATE_PRODUCTION_APPROVED=
# For migration TLS with a private CA, set the provider's PEM certificate in Vercel.
# Literal \\n separators and multiline PEM values are supported; certificate verification stays enabled.
# DATABASE_SSL_CA=
# Random 32+ char secret used to sign sessions: `openssl rand -base64 32`
AUTH_SECRET=change-me
# Optional shared AI keys, used server-side by the AI gateway (src/lib/ai). Signed-in users can use AI without adding
# their own key. Provider order, per-feature models, timeouts, retries and sensitive-data routing are set in /admin/ai.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENAI_API_KEY=
# Development only: AI_FIXTURE=1 enables a deterministic fixture provider (ignored in production).
# AI_FIXTURE=
# Staging only: APP_STAGE=staging re-enables the development fixtures (ingestion, billing, AI) on a production build so the
# full browser suite can run against a staging deployment. NEVER set on production; /admin/launch flags it as Degraded.
# APP_STAGE=
# Optional self-hosted Piston (https://github.com/engineer-man/piston) for the code runner, e.g. https://piston.example.com/api/v2.
# Without it, non-JavaScript code runs on the free public Wandbox service; JavaScript always runs in the browser.
# CODE_RUNNER_URL=

# --- Billing (Razorpay one-time passes: 90 days ₹199, 180 days ₹424, 1 year ₹799) ---
# Key pair from Razorpay Dashboard → Settings → API Keys. Use test keys until you go live.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook secret you choose when adding https://<domain>/api/billing/webhook (events: payment.captured, order.paid).
# RAZORPAY_WEBHOOK_SECRET=
# Emails that always have access without paying (operators, testers), comma separated.
# BILLING_ALLOWLIST=
# Encrypts learners' AI provider keys at rest; falls back to AUTH_SECRET when unset. `openssl rand -base64 32`
# AI_KEY_ENCRYPTION_SECRET=

# --- Sign-in ---
# Google sign-in: OAuth web client with https://<domain>/api/auth/callback/google as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email confirmation for password sign-ups. Either a Resend API key…
# RESEND_API_KEY=
# …or any SMTP server (smtp://user:pass@host:587 or smtps://user:pass@host:465).
# SMTP_URL=
# Sender shown on verification emails, e.g. "Prep by EVOLW <hello@evolw.in>". Required with either mailer.
# EMAIL_FROM=
# Public origin used in emails and metadata.
# NEXT_PUBLIC_SITE_URL=https://prep.evolw.in

# --- Admin control center (/admin) ---
# Emails that bootstrap the platform "admin" role without a database row, comma separated.
# Admins grant further roles (admin, content_editor, jobs_editor, support) from /admin/users.
# PLATFORM_ADMINS=
# Emails allowed to publish curriculum (existing); they also receive the content_editor panel role.
# CURRICULUM_ADMINS=

# --- Scheduled job ingestion ---
# Shared secret a platform cron must send as "Authorization: Bearer <secret>" to GET /api/cron/ingestion.
# Unset = the endpoint answers 404. No cron is configured in this repository; admins can run the pass from /admin/ingestion.
# CRON_SECRET=
# Also protects GET /api/cron/reminders (daily tracker and outreach follow-up reminders).
# Per-provider fetch timeout for ingestion, milliseconds (default 20000).
# INGESTION_FETCH_TIMEOUT_MS=20000

# --- Subscriptions (Career OS plans; admin-managed in /admin/plans) ---
# Razorpay Subscriptions reuse RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET above; each plan stores its Razorpay plan ids.
# Webhook for subscriptions: https://<domain>/api/billing/webhooks/razorpay signed with RAZORPAY_WEBHOOK_SECRET
# (events: subscription.activated, .charged, .pending, .halted, .cancelled, .completed, .expired, .paused).
# Outside production, when Razorpay keys are absent, a deterministic fixture provider signs test checkouts with this
# secret (falls back to AUTH_SECRET). The fixture is disabled when NODE_ENV=production.
# BILLING_FIXTURE_SECRET=
# Resume file storage: "database" (default, bytes in resume_files) or "object" (private bucket; not implemented yet,
# see docs/launch-readiness.md). Object mode also needs RESUME_OBJECT_BUCKET and RESUME_OBJECT_ENDPOINT.
# RESUME_STORE=database
